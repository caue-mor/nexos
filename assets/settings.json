{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/nexos-secret-shield.cjs\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/nexos-user-prompt-submit.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/nexos-memory-recall.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/nexos-context-warn.sh\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/nexos-docs-route.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/nexos-team-route.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/nexos-context-warn.sh\""
          }
        ]
      },
      {
        "matcher": "^(Read|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/nexos-docs-route.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__.*[Ss]upabase.*__(execute_sql|apply_migration)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/nexos-mcp-sql-write-warn.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/nexos-memory-capture.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/nexos-session-close.sh\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/nexos-absence-claim.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/nexos-absence-claim.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "nexos claude-session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/nexos-session-close.sh\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/nexos-session-close.sh\""
          }
        ]
      }
    ]
  }
}
